{
  "schemaVersion": 1,
  "id": "battery-display-profiles",
  "name": "Battery Display Profiles",
  "version": "0.3.0",
  "author": "Hazem-Ahmed-Salem",
  "license": "MIT",
  "description": "Automatically switches display profiles based on AC or battery power, with independent multi-monitor support and manual display controls.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Battery Display Profiles",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "monitors": [],
      "monitor": "",
      "acMode": "",
      "batteryMode": ""
    },
    "schema": [
      {
        "key": "monitor",
        "type": "string",
        "label": "Monitor"
      },
      {
        "key": "acMode",
        "type": "string",
        "label": "AC mode"
      },
      {
        "key": "batteryMode",
        "type": "string",
        "label": "Battery mode"
      }
    ]
  }
}